# Секретный ключ для сессий (минимум 32 символа, ОБЯЗАТЕЛЬНО смените!)
SESSION_SECRET=замените-на-случайную-строку-32-символа-минимум

# Путь к БД (для Railway/VPS с постоянным диском)
# Локально не нужно — используется ./data/app.db
DATA_DIR=/data

# Путь к загруженным файлам (для Railway/VPS)
# Локально не нужно — используется ./public/uploads
UPLOADS_DIR=/data/uploads

# Порт (Railway подставляет автоматически)
PORT=3000
